APP_NAME=BucalScan AI
ENVIRONMENT=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MINUTES=1440
DATABASE_URL=sqlite:///./bucalscan_ai.db
MODEL_PATH=models/resnet50_oral.onnx
MODEL_ARCHITECTURE=ResNet50
MODEL_VERSION=resnet50_oral_v1
IMAGE_MIN_WIDTH=224
IMAGE_MIN_HEIGHT=224
IMAGE_BLUR_THRESHOLD=100
IMAGE_DARK_LUMINANCE=20
IMAGE_BRIGHT_LUMINANCE=235
IMAGE_MAX_DARK_RATIO=0.40
IMAGE_MAX_BRIGHT_RATIO=0.40
READINESS_TIMEOUT_SECONDS=3
CORS_ORIGINS=*
# Required when ENVIRONMENT=production; set secrets only in the deployment environment.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bucalscan/analyses
